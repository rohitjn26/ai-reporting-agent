# ── Required ──────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Agent settings (defaults match docker-compose) ───────────────────────────
CUBE_MCP_URL=http://localhost:5001/sse
LIBRARY_MCP_URL=http://localhost:5002/sse
CHART_PORT=8080
CLAUDE_MODEL=claude-sonnet-4-6

# ── Checkpointer (durable agent state) ───────────────────────────────────────
# Unset → in-memory MemorySaver (fine for single-process local dev; lost on restart).
# Set → durable AsyncPostgresSaver: survives restarts and lets any replica resume
# an interrupt from saved state. Points at the dedicated checkpoint-db service
# (docker-compose), separate from the analytics data on 5432.
# CHECKPOINT_DB_URL=postgresql://postgres:postgres@localhost:5434/checkpoints
# CHECKPOINT_DB_POOL_SIZE=10
