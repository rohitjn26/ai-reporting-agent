# ── Required ──────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Agent settings (defaults match docker-compose) ───────────────────────────
CUBE_MCP_URL=http://localhost:5001/sse
LIBRARY_MCP_URL=http://localhost:5002/sse
CHART_PORT=8080
# Single model for the whole agent loop (data queries + config edits).
CLAUDE_MODEL=claude-haiku-4-5-20251001

# ── Checkpointer (durable agent state) ───────────────────────────────────────
# Unset → in-memory MemorySaver (fine for single-process local dev; lost on restart).
# Set → durable AsyncPostgresSaver: survives restarts and lets any replica resume
# an interrupt from saved state. Points at the dedicated checkpoint-db service
# (docker-compose), separate from the analytics data on 5432.
# CHECKPOINT_DB_URL=postgresql://postgres:postgres@localhost:5434/checkpoints
# CHECKPOINT_DB_POOL_SIZE=10

# ── Human feedback on queries (agent/graph/feedback.py) ──────────────────────
# Where 👍/👎 and corrected queries are stored. Unset → falls back to
# CHECKPOINT_DB_URL, else a local SQLite file (FEEDBACK_SQLITE_PATH, default agent/.feedback.db).
# FEEDBACK_DB_URL=postgresql://postgres:postgres@localhost:5433/library   # library-db (app data)
# FEEDBACK_REQUIRE_REVIEW=false   # true → feedback is "pending" until approved (POST /feedback/{id}/review)
# FEEDBACK_EXAMPLES_K=3           # past examples shown to build_query; 0 turns retrieval off
